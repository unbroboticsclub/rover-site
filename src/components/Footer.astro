---
import { Image } from "astro:assets";
import { MAIN_SITE, currentRover } from "@/data/rover.js";
import logoLight from "@/assets/logo/logo-light.png";
import logoDark from "@/assets/logo/logo-dark.png";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Rover",
    links: [
      { href: "/#mission", label: "Mission" },
      { href: "/#log", label: "Mission log" },
      { href: "/sapere", label: "Sapere" },
      { href: "/#join", label: "Join" },
      { href: "/#faq", label: "FAQ" },
    ],
  },
  {
    title: "UNB Robotics",
    links: [
      { href: MAIN_SITE, label: "Main site" },
      { href: `${MAIN_SITE}/sponsor`, label: "Sponsor us" },
      { href: `${MAIN_SITE}/contact`, label: "Contact us" },
    ],
  },
  {
    title: "Socials",
    links: [
      { href: "https://www.instagram.com/unbrobotics", label: "Instagram" },
      { href: "https://www.linkedin.com/company/unb-robotics-club/", label: "LinkedIn" },
      { href: "https://github.com/unbroboticsclub", label: "GitHub" },
    ],
  },
];
---

<footer class="border-t border-line/10 bg-page">
  <div class="wrap py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div class="flex items-start gap-6">
        <Image src={logoLight} alt="UNB Rover Team" height={224} class="h-28 w-auto shrink-0 dark:hidden" />
        <Image src={logoDark} alt="UNB Rover Team" height={224} class="hidden h-28 w-auto shrink-0 dark:block" />
        <div class="self-end">
          <p class="max-w-xs text-sm text-subtle">
            The Maritimes' first competition rover team. Now building {currentRover}.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((col) => (
          <div>
            <h3 class="label text-subtle">{col.title}</h3>
            <ul role="list" class="mt-4 space-y-2 text-sm">
              {col.links.map((l) => (
                <li><a href={l.href} class="text-muted duration-200 hover:text-accent">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line/10 pt-6 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} UNB Robotics. All rights reserved.</p>
      <nav class="flex gap-6" aria-label="Legal">
        <a href={`${MAIN_SITE}/terms`} class="hover:text-ink">Terms of Use</a>
        <a href={`${MAIN_SITE}/privacy`} class="hover:text-ink">Privacy Policy</a>
      </nav>
    </div>
  </div>
</footer>
