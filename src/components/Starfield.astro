---
// Interactive starfield: three depth layers that drift against the cursor (parallax), twinkle,
// and the occasional shooting star. Fills its positioned parent. Stays still for reduced motion.
interface Props {
  class?: string;
  /** Stars per 10,000 px² of canvas. */
  density?: number;
  /** Max parallax shift in px for the nearest layer. */
  depth?: number;
  /** Fade the field out towards the bottom (e.g. above a horizon). */
  fade?: boolean;
}
const { class: className = "", density = 1.4, depth = 28, fade = false } = Astro.props;
---

<canvas
  class:list={["starfield pointer-events-none absolute inset-0 size-full", fade && "[mask-image:linear-gradient(black_30%,transparent)]", className]}
  data-density={density}
  data-depth={depth}
  aria-hidden="true"></canvas>

<script>
  type Star = { x: number; y: number; z: number; r: number; tw: number; sp: number; red: boolean };
  type Meteor = { x: number; y: number; vx: number; vy: number; life: number };

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = matchMedia("(pointer: fine)").matches;

  // Shared pointer position, -1..1 from the viewport centre, eased per frame.
  const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener("pointermove", (e) => {
    pointer.tx = (e.clientX / innerWidth) * 2 - 1;
    pointer.ty = (e.clientY / innerHeight) * 2 - 1;
  }, { passive: true });

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const density = Number(canvas.dataset.density) || 1.4;
    const maxShift = Number(canvas.dataset.depth) || 28;
    let w = 0, h = 0, dpr = 1;
    let stars: Star[] = [];
    let meteor: Meteor | null = null;
    let nextMeteor = performance.now() + 3000 + Math.random() * 5000;
    let visible = false;
    let raf = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((w * h) / 10000 * density);
      // Pad the field so parallax never reveals an empty edge.
      const pad = maxShift * 2;
      stars = Array.from({ length: count }, () => {
        const z = Math.random() ** 2; // most stars far away
        return {
          x: Math.random() * (w + pad * 2) - pad,
          y: Math.random() * (h + pad * 2) - pad,
          z,
          r: 0.35 + z * 1.25,
          tw: Math.random() * Math.PI * 2,
          sp: 0.6 + Math.random() * 1.8,
          red: Math.random() < 0.06,
        };
      });
      if (reduce) draw(0);
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, w, h);
      const ox = -pointer.x * maxShift, oy = -pointer.y * maxShift;
      for (const s of stars) {
        const shift = 0.15 + s.z * 0.85;
        const x = s.x + ox * shift, y = s.y + oy * shift;
        if (x < -2 || y < -2 || x > w + 2 || y > h + 2) continue;
        const twinkle = reduce ? 0.8 : 0.55 + 0.45 * Math.sin(s.tw + t * 0.001 * s.sp);
        ctx!.globalAlpha = (0.35 + s.z * 0.65) * twinkle;
        ctx!.fillStyle = s.red ? "#ff5a5f" : "#ffffff";
        ctx!.beginPath();
        ctx!.arc(x, y, s.r, 0, Math.PI * 2);
        ctx!.fill();
        // Soft glow on the nearest stars.
        if (s.z > 0.8) {
          ctx!.globalAlpha *= 0.25;
          ctx!.beginPath();
          ctx!.arc(x, y, s.r * 3, 0, Math.PI * 2);
          ctx!.fill();
        }
      }
      if (meteor) {
        const m = meteor;
        const tail = 90;
        const len = Math.hypot(m.vx, m.vy);
        const grad = ctx!.createLinearGradient(m.x, m.y, m.x - (m.vx / len) * tail, m.y - (m.vy / len) * tail);
        grad.addColorStop(0, `rgba(255,255,255,${0.9 * m.life})`);
        grad.addColorStop(1, "rgba(242,53,58,0)");
        ctx!.globalAlpha = 1;
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 1.4;
        ctx!.beginPath();
        ctx!.moveTo(m.x, m.y);
        ctx!.lineTo(m.x - (m.vx / len) * tail, m.y - (m.vy / len) * tail);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
    }

    function frame(t: number) {
      pointer.x += (pointer.tx - pointer.x) * 0.05;
      pointer.y += (pointer.ty - pointer.y) * 0.05;
      // Without a mouse, drift slowly so the field still feels alive.
      if (!finePointer) {
        pointer.tx = Math.sin(t * 0.00015) * 0.6;
        pointer.ty = Math.cos(t * 0.0001) * 0.4;
      }
      if (!meteor && t > nextMeteor) {
        const fromLeft = Math.random() < 0.5;
        meteor = {
          x: fromLeft ? Math.random() * w * 0.5 : w * 0.5 + Math.random() * w * 0.5,
          y: Math.random() * h * 0.35,
          vx: (fromLeft ? 1 : -1) * (7 + Math.random() * 4),
          vy: 2.5 + Math.random() * 2,
          life: 1,
        };
      }
      if (meteor) {
        meteor.x += meteor.vx; meteor.y += meteor.vy; meteor.life -= 0.012;
        if (meteor.life <= 0 || meteor.x < -100 || meteor.x > w + 100 || meteor.y > h + 100) {
          meteor = null;
          nextMeteor = t + 5000 + Math.random() * 9000;
        }
      }
      draw(t);
      raf = visible ? requestAnimationFrame(frame) : 0;
    }

    function start() {
      if (reduce || raf || !visible || document.hidden) return;
      raf = requestAnimationFrame(frame);
    }

    new ResizeObserver(resize).observe(canvas);
    // Only animate while on screen.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
      else { cancelAnimationFrame(raf); raf = 0; }
    }).observe(canvas);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; } else start();
    });
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.starfield").forEach(setup);
</script>
