---
import { MAIN_SITE } from "@/data/rover.js";

const links = [
  { href: "/#about", label: "About" },
  { href: "/sapere", label: "Sapere" },
  { href: "/#faq", label: "FAQ" },
  { href: `${MAIN_SITE}/sponsor`, label: "Sponsor Us" },
];
---

<div class="fixed top-0 inset-x-0 z-50">
  <div class="w-full px-8">
    <div class="w-full mx-auto">
      <div class="relative flex flex-row flex-wrap w-full p-4 mx-auto bg-page/80 border border-line/20 shadow-thick backdrop-blur-xl backdrop-filter rounded-lg items-center justify-between px-8">
        <a
          class="text-ink items-center font-bold gap-3 inline-flex text-xl"
          href="/"
          title="link to home page"
          aria-label="UNB Rover Team">
          <span>UNB Rover Team</span>
        </a>

        <div class="flex items-center gap-2 md:order-last md:ml-6">
          <button
            id="theme-toggle"
            type="button"
            title="Switch day / night"
            aria-label="Switch between day and night theme"
            class="inline-flex items-center justify-center size-9 rounded-full border border-line/20 text-ink hover:text-accent duration-200">
            <!-- Moon in day mode, sun in night mode -->
            <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
            <svg class="size-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
          </button>

          <button
            id="nav-toggle"
            type="button"
            aria-controls="nav-menu"
            aria-expanded="false"
            aria-label="Toggle menu"
            class="inline-flex items-center justify-center p-2 text-subtle hover:text-accent focus:outline-none md:hidden">
            <svg class="size-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <nav id="nav-menu" class="hidden w-full md:w-auto md:flex md:ml-auto py-6 md:py-0">
          <ul class="space-y-4 list-none md:space-y-0 text-sm text-ink items-center md:inline-flex justify-center text-center gap-6">
            {links.map((link) => (
              <li>
                <a href={link.href} title={link.label} class="lg:py-6 hover:text-accent">{link.label}</a>
              </li>
            ))}
            <li>
              <a
                href={MAIN_SITE}
                title="UNB Robotics"
                class="bg-rover-red hover:bg-rover-red-light text-white font-bold px-4 py-2 rounded-md transition-all duration-200 shadow-[0_0_16px_rgba(220,1,6,0.35)] hover:shadow-[0_0_28px_rgba(220,1,6,0.55)] hover:-translate-y-px inline-block">
                Main Site ↗
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  toggle?.addEventListener("click", () => {
    const open = !menu.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    })
  );

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
