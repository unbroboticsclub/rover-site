---
import { Image } from "astro:assets";
import { MAIN_SITE } from "@/data/rover.js";
import markLight from "@/assets/logo/mark-light.png";
import markDark from "@/assets/logo/mark-dark.png";

const links = [
  { href: "/#mission", label: "Mission" },
  { href: "/#log", label: "Mission log" },
  { href: "/sapere", label: "Sapere" },
  { href: "/#join", label: "Join" },
  { href: "/#faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-line/10 bg-page/85 backdrop-blur-xl">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 py-3">
    <a href="/" class="inline-flex items-center gap-3 text-ink" aria-label="UNB Rover Team home">
      <Image src={markLight} alt="" height={64} class="h-8 w-auto dark:hidden" loading="eager" />
      <Image src={markDark} alt="" height={64} class="hidden h-8 w-auto dark:block" loading="eager" />
      <span class="font-display text-xl font-bold uppercase tracking-wide leading-none">
        UNB Rover Team
      </span>
    </a>

    <div class="flex items-center gap-2 lg:order-last">
      <button
        id="theme-toggle"
        type="button"
        title="Switch day / night"
        aria-label="Switch between day and night theme"
        class="inline-flex size-9 items-center justify-center rounded-sm border border-line/15 text-ink duration-200 hover:border-accent hover:text-accent">
        <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg class="size-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>

      <button
        id="nav-toggle"
        type="button"
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label="Toggle menu"
        class="inline-flex size-9 items-center justify-center rounded-sm border border-line/15 text-ink hover:text-accent lg:hidden">
        <svg class="size-5" stroke="currentColor" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>

    <nav id="nav-menu" class="hidden w-full lg:ml-auto lg:flex lg:w-auto" aria-label="Main">
      <ul class="flex flex-col gap-1 py-4 lg:flex-row lg:items-center lg:gap-7 lg:py-0">
        {links.map((link) => (
          <li>
            <a href={link.href} class="label block py-2 text-muted duration-200 hover:text-accent lg:py-0">
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-2 lg:mt-0">
          <a
            href={MAIN_SITE}
            class="label inline-flex items-center gap-1 rounded-sm bg-rover-red px-3 py-2 text-white duration-200 hover:bg-rover-red-light">
            UNB Robotics <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  toggle?.addEventListener("click", () => {
    const open = !menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
