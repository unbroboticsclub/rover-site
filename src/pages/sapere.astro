---
import { Image } from "astro:assets";
import RoverLayout from "@/layouts/RoverLayout.astro";
import SectionHead from "@/components/SectionHead.astro";
import Starfield from "@/components/Starfield.astro";
import { MAIN_SITE, APPLY_FORM, competition, currentRover, sapere, stats, sponsors, roles } from "@/data/rover.js";
import { btnPrimary, btnRed, btnGhost } from "@/styles/classes.js";

import teamPhoto from "@/assets/rover/circ2026/team-photo.jpg";
import roverBuilding2 from "@/assets/rover/circ2026/rover-building-2.JPG";
import roverBuilding from "@/assets/rover/circ2026/rover-building.JPG";
import circSign from "@/assets/rover/circ2026/circ-sign.JPG";
import sponsorBanner from "@/assets/rover/circ2026/sponsor-banner.jpg";
import meeting1 from "@/assets/rover/Rover_Design_Meeting_1.jpeg";
import meeting3 from "@/assets/rover/Rover_Design_Meeting_3.jpeg";
import meeting from "@/assets/rover/roverprojectdesignmeeting.JPG";

// The second photo (index 1) is shown as the large featured tile.
const gallery = [
  { src: teamPhoto, alt: "UNB Rover Team members with Sapere and the sponsor banner at CIRC 2026" },
  { src: roverBuilding2, alt: "Sapere's electronics and drivetrain laid out on the floor of the CIRC 2026 pit area" },
  { src: circSign, alt: "Canadian International Rover Challenge sign outside the Badlands Community Facility" },
  { src: roverBuilding, alt: "A team member working on Sapere at the team's bench during CIRC 2026" },
  { src: sponsorBanner, alt: "Thank you to our sponsors banner at CIRC 2026" },
  { src: meeting3, alt: "Sapere design meeting" },
  { src: meeting1, alt: "Sapere design meeting in Head Hall" },
  { src: meeting, alt: "Sapere design session" },
];
---

<RoverLayout
  title="Sapere | UNB Rover Team"
  description={`Sapere was UNB Robotics' first rover, which competed at the ${sapere.year} ${competition.name}.`}
>
  <!-- HERO -->
  <section class="relative isolate bg-grid pb-16 pt-32 lg:pb-24 lg:pt-40">
    <div class="absolute inset-0 -z-10 hidden dark:block"><Starfield fade density={1.6} /></div>
    <div class="wrap grid items-end gap-12 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <p class="label text-subtle">
          <span class="text-accent">Mission 01 · Complete</span> · {competition.short} {sapere.year} · {sapere.dates}
        </p>
        <h1 class="display mt-4 text-[clamp(5rem,15vw,10rem)] leading-[0.82] text-ink">{sapere.name}</h1>
        <p class="mt-6 max-w-lg text-lg text-muted text-balance">
          Every year our rover gets a new name. Sapere was the first, built by 60+ UNB students and
          taken to the {competition.name}, organized by {competition.organizer}. This year we're
          building its successor, {currentRover}.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#sponsors" class={btnPrimary}>Our sponsors</a>
          <a href="/" class={btnGhost}>Meet {currentRover} →</a>
        </div>
      </div>
      <figure data-reveal data-reveal-delay="150">
        <div class="frame">
          <Image src={teamPhoto} alt="UNB Rover Team members with Sapere at CIRC 2026"
                 widths={[700, 1200]} sizes="(min-width: 1024px) 55vw, 100vw" loading="eager"
                 class="aspect-[16/10] w-full rounded-sm object-cover" />
        </div>
        <figcaption class="label mt-4 text-subtle">Fig. 01 — The team with Sapere at {competition.short} {sapere.year}</figcaption>
      </figure>
    </div>
  </section>

  <!-- MISSION LOG -->
  <section class="border-y border-line/10 bg-[#060608] text-white" aria-label="Sapere by the numbers">
    <dl class="wrap grid md:grid-cols-2">
      {stats.map((s, i) => (
        <div data-reveal data-reveal-delay={i * 100} class:list={["py-10 md:px-8", i > 0 && "border-t border-white/15", i === 1 && "md:border-t-0", i % 2 === 1 && "md:border-l", i % 2 === 0 && "md:pl-0"]}>
          <dt class="label text-white/50">{s.label}</dt>
          <dd class="mt-2 font-display text-6xl font-bold text-rover-red-light lg:text-7xl">{s.value}</dd>
          <dd class="mt-3 max-w-xs text-sm text-white/70">{s.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- SPONSORS -->
  <section id="sponsors" class="scroll-mt-20 py-24 lg:py-32">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
        <SectionHead index="01" label="Mission partners">
          Made possible<br /><span class="text-accent">by our sponsors.</span>
        </SectionHead>
        <p class="max-w-md text-muted lg:justify-self-end">
          Together our sponsors and partners contributed {sapere.sponsorFunding} toward rover equipment in {sapere.year}, plus {sapere.inKindSponsorship} in in-kind sponsorship.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-sm bg-line/10 ring-1 ring-line/10 md:grid-cols-3">
        {sponsors.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" title={s.name}
             class="group flex aspect-[4/3] flex-col items-center justify-between bg-white p-6">
            <div class="flex w-full grow items-center justify-center">
              <img src={s.logo} alt={s.name} class="max-h-20 w-auto object-contain sm:max-h-24" />
            </div>
            <span class="label text-neutral-500 duration-200 group-hover:text-[#B00005]">{s.name} ↗</span>
          </a>
        ))}
      </div>

      <div data-reveal class="mt-6 grid items-center gap-8 rounded-sm bg-rover-red p-8 text-white lg:grid-cols-[1fr_auto] lg:p-12">
        <div>
          <p class="label text-white/75">Now seeking sponsors</p>
          <h3 class="display mt-3 text-4xl lg:text-5xl">Put your name on {currentRover}.</h3>
          <p class="mt-4 max-w-2xl text-white/85">
            As we build {currentRover}, we're looking for new partners through sponsorship tiers or donations
            of electronics, PCB fabrication, filament, materials, software licenses, and tools.
          </p>
        </div>
        <a href={`${MAIN_SITE}/sponsor`}
           class="inline-flex items-center justify-center rounded-sm bg-white px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-black duration-200 hover:bg-black hover:text-white">
          Become a sponsor
        </a>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="scroll-mt-20 border-t border-line/10 bg-panel py-24 lg:py-32">
    <div class="wrap">
      <SectionHead index="02" label="Mission log">
        From the build<br />to {`${competition.short} ${sapere.year}`}.
      </SectionHead>
      <div class="mt-14 grid grid-flow-dense grid-cols-2 gap-3 lg:grid-cols-4">
        {gallery.map((g, i) => (
          <figure data-reveal data-reveal-delay={(i % 4) * 70} class:list={["overflow-hidden rounded-sm", i === 1 && "col-span-2 row-span-2"]}>
            <Image
              src={g.src}
              alt={g.alt}
              widths={[480, 900]}
              sizes={i === 1 ? "(min-width: 1024px) 50vw, 100vw" : "(min-width: 1024px) 25vw, 50vw"}
              class="size-full aspect-[4/3] object-cover duration-500 hover:scale-[1.03]"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- RECRUITING -->
  <section class="py-24 lg:py-32">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-start">
      <SectionHead index="03" label="Crew wanted">
        Help lead<br /><span class="text-accent">{currentRover}.</span>
      </SectionHead>
      <div>
        <ul class="border-t border-line/15">
          {roles.map((r) => (
            <li class="flex flex-col gap-1 border-b border-line/15 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <span class="font-display text-2xl font-bold uppercase text-ink">{r.title}</span>
              <span class="text-sm text-subtle sm:text-right">{r.focus}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={APPLY_FORM} class={btnRed}>Apply now</a>
          <a href="/#faq" class={btnGhost}>Read the FAQ</a>
        </div>
      </div>
    </div>
  </section>
</RoverLayout>
