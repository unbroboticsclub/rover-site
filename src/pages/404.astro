---
import RoverLayout from "@/layouts/RoverLayout.astro";
import Starfield from "@/components/Starfield.astro";
import { btnPrimary, btnGhost } from "@/styles/classes.js";
---

<RoverLayout title="Page Not Found | UNB Rover Team" noindex>
  <section class="relative isolate bg-grid flex min-h-[80svh] items-center pt-24">
    <div class="absolute inset-0 -z-10 hidden dark:block"><Starfield alt={90} fov={120} depth={40} /></div>
    <div class="wrap">
      <p class="label text-accent">Error 404 · Signal lost</p>
      <h1 class="display mt-4 text-[clamp(4rem,14vw,9rem)] leading-[0.85] text-ink">Off the map.</h1>
      <p class="mt-6 max-w-md text-lg text-muted">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class={btnPrimary}>Back to base</a>
        <a href="/sapere" class={btnGhost}>Meet Sapere</a>
      </div>
    </div>
  </section>
</RoverLayout>
