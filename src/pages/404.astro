---
import RoverLayout from "@/layouts/RoverLayout.astro";
---

<RoverLayout title="Page Not Found | UNB Rover Team" noindex>
  <section class="lg:p-8 mt-24">
    <div class="mx-auto 2xl:max-w-7xl rounded-[3rem] py-24 lg:px-16 px-8 bg-gradient-to-b from-hero-from to-hero-to">
      <div class="max-w-xl">
        <h1 class="text-3xl tracking-tight mt-6 font-light lg:text-4xl text-ink">
          Page not found
          <span class="block text-accent">Error 404.</span>
        </h1>
        <p class="text-ink mt-6">The page you're looking for doesn't exist or has been moved.</p>
        <div class="inline-flex flex-wrap items-center mt-8">
          <a href="/" class="text-sm py-2 px-4 border rounded-full border-transparent bg-ink hover:bg-ink/10 text-page hover:text-ink duration-200 inline-flex items-center justify-center">
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </section>
</RoverLayout>
